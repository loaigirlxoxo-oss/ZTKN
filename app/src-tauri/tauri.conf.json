{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZTKN",
  "version": "0.3.3",
  "identifier": "com.loaivoice.ztkn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p ztkn-hook --manifest-path src-tauri/Cargo.toml",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ZTKN",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": [
            "$HOME/.claude/**",
            "$HOME/.codex/**",
            "$HOME/.antigravity/**",
            "$HOME/.ssh/**",
            "$HOME/.aws/**",
            "$HOME/.gnupg/**",
            "$HOME/.config/**",
            "$APPDATA/**",
            "$APPLOCALDATA/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 Lo-Ai Voice. All rights reserved.",
    "publisher": "Lo-Ai Voice",
    "targets": ["nsis"],
    "resources": {
      "binaries/sensor-sidecar-x86_64-pc-windows-msvc.exe": "sensor-sidecar.exe",
      "target/release/ztkn-hook.exe": "ztkn-hook.exe",
      "installer-deps/PawnIO_setup.exe": "PawnIO_setup.exe",
      "../Assets": "Assets",
      "../Panels": "Panels"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}

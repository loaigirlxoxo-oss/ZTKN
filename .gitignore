# Node
node_modules/
dist/
.vite/

# Rust / Tauri
**/target/
app/src-tauri/gen/

# .NET sidecar build artifacts（exe は dotnet publish で生成。下記スクリプト参照）
tools/sensor-sidecar/bin/
tools/sensor-sidecar/obj/
tools/sensor-sidecar/publish/
app/src-tauri/binaries/*.exe

# 同梱するサードパーティ署名ドライバのインストーラ（PawnIO版のみ。公式から取得して配置）
# 取得元: https://github.com/namazso/PawnIO.Setup/releases → PawnIO_setup.exe を
#   app/src-tauri/installer-deps/ に置く。サイレント導入: -install -silent
app/src-tauri/installer-deps/*.exe

# Logs & OS
*.log
.DS_Store
Thumbs.db

# stray capture
tools/sensor-sidecar/out.txt

# app/Assets と app/Panels はインストーラに同梱されるため Git 管理下に置く。
# （管理外だと、配布物に何が入るかが GitHub のソースから確認できず、
#   clone してもビルドできない。実際 v0.3.0 には開発機の絶対パスが混入した）
# 個人的な作業用の1枚絵は配布対象外なので除外を続ける。
app/image/

# 素材パックの生ダウンロードをリポジトリ直下に置いた場合の保険。
# app/Assets/ 配下の同名パックは配布物なので追跡する（先頭の / で直下限定にしている）。
/aida64-skin-*/
